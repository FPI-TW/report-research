# 廷豐研報 App 登入帳密與 session 簽章金鑰
# 複製本檔為 .env(已 gitignore),填入實際值。
# 未設 USERNAME / PASSWORD 時 App 會拒絕啟動(fail-closed)。
# 註：App 會以 dotenv 方式直接讀本檔，不做 shell 展開。
#     值含空白可用雙引號包住，例如 REPORT_MARK_ACCESS_PASSWORD="my pass!"；
#     其中的 $、`、; 等字元都會保留為原字面值。
REPORT_MARK_ACCESS_USERNAME=tingfeng
REPORT_MARK_ACCESS_PASSWORD=請改成你的密碼

# 固定一組長隨機字串;未設則每次重啟都會把所有人登出。
# 產生:python -c "import secrets; print(secrets.token_hex(32))"
REPORT_MARK_SESSION_SECRET=請填入長隨機字串

# (選用)全員登出開關。值會進入 session token 的簽章訊息,所以**改成任何新字串
# 並重啟,就等於把所有人登出**——不必換密碼、也不必輪替上面那把金鑰。
# 用途:懷疑某個 cookie 外流、或離職交接時的一次性清場。慣例是填日期或流水號。
# 註:換 REPORT_MARK_ACCESS_PASSWORD 現在同樣會讓既有 session 立即失效(帳密指紋
#    也在簽章訊息內),此旋鈕是「不想動帳密時」的手段。
# REPORT_MARK_SESSION_EPOCH=1

# (選用)邊緣共享祕密。設了之後,只要請求帶著相符的 `X-Edge-Secret` header 就算
# 可信反向代理,不必依賴下面那組會漂移的 CIDR(WSL 重開機換網段 = 全體外網登入被擋,
# 2026-07-17 實際事故)。兩者是 **OR**:任一成立即可信,所以 nginx 與 App 誰先改都
# 不會出現空窗。**必須與 deploy/.env 的 EDGE_SECRET 逐字相同**;留空＝停用此路徑。
# 產生:python -c "import secrets; print(secrets.token_urlsafe(32))"
# REPORT_MARK_EDGE_SECRET=

# 信任的反向代理來源 CIDR(逗號分隔)。App 只對這些來源採信其送來的
# X-Forwarded-Proto(判定 HTTPS) 與 X-Real-IP(還原真實來源 IP)。未設時只信任 loopback。
# ⚠️ 走 Cloudflare Tunnel 外網時「必填」:請求路徑 nginx→host.docker.internal:8097→uvicorn,
#    uvicorn 看到的來源 IP 是 Docker Desktop→WSL host 閘道(通常 172.x.x.1),不在 loopback 內。
#    不加的話,外網登入會被擋並顯示「此登入只接受 HTTPS 或本機 localhost」。
#    查實際 IP:啟動 serve 後看 data/serve_edge.log 裡 nginx 進來的來源位址(此 IP 可能隨 WSL 重開機變動)。
# REPORT_MARK_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.20.48.1/32

# (選用)DB 連線;不設則用預設 localhost:5436
# REPORT_MARK_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/research

# ── 私有 Cloudflare R2（選用；預設 local，既有 NAS/本機流程完全不變）────────
# local = 僅用既有路徑；hybrid = R2 優先讀、local 回退；
# r2 = 僅 R2（缺任何設定會在啟動時 fail-closed）。只存研報原檔（originals/）。
# OBJECT_STORAGE_MODE=local
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=report-mark
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRESIGN_TTL_SECONDS=3600

# (選用)日誌等級;預設 INFO。合法值 CRITICAL/ERROR/WARNING/INFO/DEBUG(大小寫不拘),
# 打錯會退回 INFO 並在啟動時警告,不會讓 app 起不來。
# INFO 才看得到 answer.py 的 qa_timing 分段耗時與 qa_agentic 降級旗標;
# 調成 WARNING 等於關掉那兩條遙測。
# **登入稽核也被這個值切成兩半**:登入失敗/限流鎖定/非 HTTPS 遭拒是 WARNING(調到
# WARNING 仍留存),但**登入成功是 INFO**——調成 WARNING 等於放棄「誰在何時登入」
# 這一半稽核,只剩攻擊面那一半。要完整稽核就別把它調高。
# LOG_LEVEL=INFO

# 觀點雷達目錄（/api/radar/instruments）回應快取秒數；0＝停用。
# report_signal 每 3 小時才由批次更新，60 秒的舊資料看不出來。
# RADAR_CATALOG_CACHE_TTL=60

# ── 嵌入模型的執行緒紀律（選用；預設值即 app/config.py 內建值）──────────────
# BGE-M3 的 model.encode 是 CPU-bound，而每個 web 呼叫端都經 asyncio.to_thread 丟進
# 預設執行緒池（min(32, cpu+4) 條）。/api/search、雷達、閱讀頁**完全沒有併發閘**，
# 所以同時進 encode 的執行緒數沒有上界，而 torch 自己還會再開 intra-op 執行緒——
# CPU-only 推論下兩層相乘就是嚴重超額訂閱，症狀不是錯誤而是每一條都變慢。
# 預設 1＝序列化。CPU-bound 工作序列化不損總吞吐（反而少了搶核而變快）。
# 填 0 或負數會被當成 1（0 的語意會是「誰都不准跑」＝永久掛住）。
# EMBED_MAX_CONCURRENCY=1
# 0＝不設，沿用 torch 預設（實體核心數）。與上面那個閘配合：併發限 1 時讓 torch 用滿
# 核心是對的；把併發開大就該同步調小這個值，否則兩層相乘。
# EMBED_TORCH_THREADS=0

# ── DB 連線池與查詢逾時（全部選用；預設值即為 app/config.py 內建值）──────────
# 連線池是 **per-process**：一個 uvicorn worker 一個池，每支批次腳本各自一個池。
#
# **調大併發之前先算連線數。** 算式：
#     worker 數 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + 同時在跑的批次腳本數 × 2
#   必須小於 DB 的 max_connections 扣掉 superuser_reserved_connections。
#   目前：DB 跑 pgvector/pgvector:pg16 官方映像、Makefile 沒帶任何 postgresql.conf
#   覆寫 → max_connections=100、superuser_reserved=3 → 一般角色可用 97。
#   現況 1 × (5+15) + 3 × 2 = 26。有併發閘的路徑只有 /api/ask(3)，其餘 17 條留給
#   /api/search、雷達、閱讀頁、監控頁這些無閘路徑。要加 uvicorn --workers、或放寬
#   web/routers/ask.py 的 _ASK_GATE（容量寫死 3）之前，重算這條式子。
# DB_POOL_SIZE=5             # 常駐連線數
# DB_MAX_OVERFLOW=15         # 突發可再開的連線數；上限 = POOL_SIZE + MAX_OVERFLOW
# DB_POOL_TIMEOUT=10         # 等不到連線就放棄的秒數（池滿在單 worker 下已是異常）
# DB_POOL_RECYCLE=1800       # 連線最長壽命（秒）；比 pre_ping 更早汰換被中介砍掉的連線
#
# statement_timeout：沒有它，單一失控查詢可以無上限佔住一條連線——**這才是連線耗盡
# 的真正成因**，不是「併發使用者太多」（2026-07-29 AST 複驗：44 個 session 區塊沒有
# 任何一個跨 LLM 串流）。刻意不取更小的值：雷達目錄、overview 分面、閱讀頁 similar
# 都是天生偏慢的查詢，設太小會把正常功能打掛。
# DB_STATEMENT_TIMEOUT_MS=60000
#
# idle_in_transaction_session_timeout：**預設 0（關）是刻意的。**
# scripts/sync_new_reports.py 先 report_exists() 開了交易，接著才 spawn claude CLI
# 標註（硬逾時 150s）與跑 BGE-M3 嵌入（大檔數分鐘），中間沒有 commit ⇒ 設了它，
# 每 3 小時一次的生產同步會把報告靜默丟進 data/sync_failures.log。
# 要開就**只在 web 開**：批次腳本不讀 repo 根的 .env（sync unit 走
# /etc/default/report-mark-sync），所以在這裡設值天然只影響 web 行程。
# DB_IDLE_TX_TIMEOUT_MS=60000
#
# 維運長查詢的豁免值（0＝不限），給 db.relax_statement_timeout() 用的 SET LOCAL 值。
# 匯入最後那句 ANALYZE research.report_chunk 要在 70 萬列 × vector(1024) 上抽樣，
# 可能久於上面的 60s；它是最後一步，被砍掉只會靜默留下過期的 planner 統計。
# DB_MAINTENANCE_STATEMENT_TIMEOUT_MS=0

# ── M8 忠實度查核（全部選用；預設值即為程式內建值）────────────────────────
# 查核「回答裡的主張有沒有語料支持」，結果寫進 qa_log.evaluation（jsonb）。
# 讀取路徑：監控頁「忠實度查核」卡片，
# 以及 `uv run python scripts/eval_faithfulness.py`（可 --claims <id> 逐條下鑽）。
#
# 全程 fail-open：judge 異常時該筆會寫 degraded=true、分數留 None，主流程不受影響。
# 這也代表**關掉或壞掉都不會有錯誤訊息**，只會讓 evaluation 停止累積——
# 監控卡片上的 fail-open 計數與「最後查核」日期就是為此存在。
# ASK_FAITHFULNESS_ENABLED=1           # 問答端抽查（done 之後才跑，不影響回應延遲）
# FAITHFULNESS_MIN=0.9                 # 監控頁「待複核」與離線評測的支持率門檻；舊名 REPORT_FAITHFULNESS_MIN 仍可讀（深度研報移除前的鍵名）
# ASK_FAITHFULNESS_SAMPLE_RATE=1.0     # 問答抽樣率 0..1（只查含金融數字的回答）
# FAITHFULNESS_MODEL=claude-haiku-4-5  # 生產忠實度 judge；未設或空字串＝查表（兩張表都是 claude-haiku-4-5，不隨 LLM_PROVIDER 換）。換掉＝換尺：監控卡、待複核只計現行 judge
# FAITHFULNESS_TIMEOUT=60              # judge 單次呼叫的通用逾時（秒）；目前沒有呼叫端（問答抽查用下一顆，scripts/eval_faithfulness.py 不呼叫 LLM）
# ASK_FAITHFULNESS_TIMEOUT=240         # 問答抽查專用逾時（秒）；實測 ground 單次需 48–142 秒。逾時＝degraded，不是低分
# ASK_FAITHFULNESS_MAX_INFLIGHT=2      # 同時在背景跑的問答抽查上限；抽查已脫離 /api/ask 併發閘，超過即跳過該次（不排隊）

# ── LLM 供應商與各任務模型（全部選用；app/services/llm_models.py）──────────────
# 解析規則：任務旋鈕有非空值就用它，**空字串視同未設**；否則查 LLM_PROVIDER 的預設表。
#   claude_cli  （預設）Claude 預設表，與遷移前各呼叫點的模型逐字相同
#   deepseek    DeepSeek 預設表：deepseek-flash；網搜與兩個 judge 仍是 Claude
#   claude_only 緊急回退：任務旋鈕裡的 DeepSeek 名稱一律忽略，全部用 Claude 預設表（記 WARNING）
# 未知值記 ERROR 並當成 claude_cli。模型名只接受 DeepSeek 白名單（deepseek-flash、
# deepseek-v4-pro、deepseek-v4-flash）或 claude-*，其他名稱（含 CLI 別名 sonnet／haiku）啟動自檢記 ERROR。
# 線上與評測經 stream_completion 依白名單分派到 DeepSeek。批次（run_claude、generate_brief）在 PR-12
# 之前沒有分派：批次解析到白名單名稱時，預檢以 rc=2 拒跑（行內標註拒跑＝新研報停止入庫）。
# 所以 PR-12 之前 LLM_PROVIDER=deepseek 只能設在本檔（web），不可設在 /etc/default/report-mark-llm。
# 改完重啟 web；批次各自在下一輪讀取。
# LLM_PROVIDER=claude_cli
#
# DeepSeek 金鑰：web 讀本檔的 DEEPSEEK_API_KEY；批次與 sync unit 讀 /etc/default/report-mark-llm
# （deploy/systemd/report-mark-llm.env.example）。**兩份逐字相同**，改完重啟 web（不需 daemon-reload）；
# 落點與輪替步驟見 docs/production_resilience.md。
# DEEPSEEK_API_KEY=
#
# 線上任務（web 行程；未設＝查表，claude_cli 下的值寫在右邊）
# ASK_ANSWER_MODEL=       # 總覽、主答（不開網搜）、評測生成的預設；claude-sonnet-5
# ASK_WEB_MODEL=          # 時效題網搜、主答開網搜；claude-sonnet-5（兩張表都是，DeepSeek 網搜尚未實作）
# ASK_INTENT_MODEL=       # 首輪五類路由；claude-haiku-4-5
# ASK_CONDENSE_MODEL=     # 續問改寫；claude-haiku-4-5（不再跟隨 ASK_INTENT_MODEL）
# QA_PLANNER_MODEL=       # 查詢規劃與 agentic 證據評估；claude-haiku-4-5（不再跟隨 ASK_INTENT_MODEL）
# ASK_FOLLOWUP_MODEL=     # 追問建議；claude-haiku-4-5-20251001
# FAITHFULNESS_MODEL 見上方 M8 區段（兩張表都是 claude-haiku-4-5）
#
# 離線評測與批次（批次不讀本檔：sync unit 與手動批次都讀 /etc/default/report-mark-llm，
# 由 scripts/_llm_env.py 只補環境裡還不存在的鍵；這裡列出只為完整）。
# PR-12 之前批次旋鈕只能填 claude-* 或留空：填 DeepSeek 名稱，批次預檢會 rc=2 拒跑。
# EVAL_JUDGE_MODEL=       # RAGAS judge；claude-haiku-4-5（兩張表都是）
# TAG_MODEL=              # 行內標註與全語料標註；claude-haiku-4-5
# SUMMARY_MODEL=          # claude-sonnet-5
# TITLE_MODEL=            # claude-sonnet-5
# TAKEAWAY_MODEL=         # 摘錄（逐字引文）；claude-sonnet-5
# SIGNAL_MODEL=           # 訊號（逐字證據）；claude-sonnet-5
# BRIEF_MODEL=            # 每日簡報；claude-sonnet-5

# ── 併發與排隊（選用；預設值即為程式內建值）────────────────────────────
# /api/ask 併發上限 3 是**行程內**狀態（問答忠實度抽查的 ASK_FAITHFULNESS_MAX_INFLIGHT
# 也是）：加 uvicorn --workers 會讓上限翻倍、BGE-M3 與 reranker 記憶體也翻倍，故啟動時會
# fail-closed 拒絕多 worker（web/concurrency.py）。要提高吞吐請先讀該檔。
# 滿載時 SSE 會先送一個 queued 事件（否則使用者只看到「連線建立但沒有任何回應」）；
# 排隊人數超過上限則在建立串流前回 429 + Retry-After（0 = 不限，退回舊行為）。
# ASK_MAX_QUEUE=20        # 問答排隊上限（上限 3、單題 60-90s）

# ── 問答網路搜尋（M11；選用，預設值即為程式內建值）─────────────────────
# 網搜是**每題由使用者決定**的（前端 Composer 的「搜尋網路」開關 → /api/ask 的
# web 欄位，預設關閉）。下面這個是**伺服器端總閘**：設 0 之後前端送 true 也一律
# 關閉——整站停用網搜不必動前端。預設 1 的意思是「允許使用者開」，不是「一律開」。
# ASK_ENABLE_WEB=1        # 0 = 全站禁用問答網搜（使用者開關失效）
# 開網搜那一輪的主 LLM 逾時。語意是「第一個輸出（文字或網搜標記）」的期限、不是總時限：
# 問答經 SSE 心跳包裝驅動，逾時在第一個輸出之後就不再生效（見 app/services/answer.py 的
# ASK_WEB_TIMEOUT 註解）。網搜可能很久才出第一個字，沿用 llm.py 的 120s 會被誤判逾時。
# 不開網搜的路徑不受此值影響。
# ASK_WEB_TIMEOUT=240     # 秒

# ── 抽取器（docs/EXTRACTION.md §4、§5）──
# pypdf＝舊路徑；pdfplumber＝版面層（閱讀順序、表格欄界、頁級失敗記錄）。程式預設 pypdf，
# 生產在 sync 鏈的環境檔（deploy/systemd/report-mark-sync.env.example）設 pdfplumber。
# 未知值退回 pypdf 並警告。
# EXTRACTOR=pypdf
# needs_review 門檻（只標記不擋）：總分低於 MIN、coverage 低於 MIN_COVERAGE、亂碼率高於
# MAX_GARBLED 任一成立即標記。三個預設都是抽樣量出來的，改之前先看 docs/EXTRACTION.md §5。
# EXTRACTION_REVIEW_MIN=0.6
# EXTRACTION_REVIEW_MIN_COVERAGE=0.30
# EXTRACTION_REVIEW_MAX_GARBLED=0.02
