# 廷豐研報 App 登入帳密與 session 簽章金鑰
# 複製本檔為 .env(已 gitignore),填入實際值。
# 未設 USERNAME / PASSWORD 時 App 會拒絕啟動(fail-closed)。
# 註：App 會以 dotenv 方式直接讀本檔，不做 shell 展開。
#     值含空白可用雙引號包住，例如 REPORT_MARK_ACCESS_PASSWORD="my pass!"；
#     其中的 $、`、; 等字元都會保留為原字面值。
REPORT_MARK_ACCESS_USERNAME=tingfeng
REPORT_MARK_ACCESS_PASSWORD=請改成你的密碼

# 固定一組長隨機字串;未設則每次重啟都會把所有人登出。
# 產生:python -c "import secrets; print(secrets.token_hex(32))"
REPORT_MARK_SESSION_SECRET=請填入長隨機字串

# 信任的反向代理來源 CIDR(逗號分隔)。App 只對這些來源採信其送來的
# X-Forwarded-Proto(判定 HTTPS) 與 X-Real-IP(還原真實來源 IP)。未設時只信任 loopback。
# ⚠️ 走 Cloudflare Tunnel 外網時「必填」:請求路徑 nginx→host.docker.internal:8097→uvicorn,
#    uvicorn 看到的來源 IP 是 Docker Desktop→WSL host 閘道(通常 172.x.x.1),不在 loopback 內。
#    不加的話,外網登入會被擋並顯示「此登入只接受 HTTPS 或本機 localhost」。
#    查實際 IP:啟動 serve 後看 data/serve_edge.log 裡 nginx 進來的來源位址(此 IP 可能隨 WSL 重開機變動)。
# REPORT_MARK_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.20.48.1/32

# (選用)DB 連線;不設則用預設 localhost:5436
# REPORT_MARK_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/research

# (選用)日誌等級;預設 INFO。合法值 CRITICAL/ERROR/WARNING/INFO/DEBUG(大小寫不拘),
# 打錯會退回 INFO 並在啟動時警告,不會讓 app 起不來。
# INFO 才看得到 answer.py 的 qa_timing 分段耗時與 qa_agentic 降級旗標;
# 調成 WARNING 等於關掉那兩條遙測。
# LOG_LEVEL=INFO

# ── DB 連線池與查詢逾時（全部選用；預設值即為 app/config.py 內建值）──────────
# 連線池是 **per-process**：一個 uvicorn worker 一個池，每支批次腳本各自一個池。
#
# **調大併發之前先算連線數。** 算式：
#     worker 數 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + 同時在跑的批次腳本數 × 2
#   必須小於 DB 的 max_connections 扣掉 superuser_reserved_connections。
#   目前：DB 跑 pgvector/pgvector:pg16 官方映像、Makefile 沒帶任何 postgresql.conf
#   覆寫 → max_connections=100、superuser_reserved=3 → 一般角色可用 97。
#   現況 1 × (5+15) + 3 × 2 = 26。要加 uvicorn --workers、提高 REPORT_SEMAPHORE、
#   或放寬 web/routers/ask.py 的 _ASK_GATE（容量寫死 3）之前，重算這條式子。
# DB_POOL_SIZE=5             # 常駐連線數
# DB_MAX_OVERFLOW=15         # 突發可再開的連線數；上限 = POOL_SIZE + MAX_OVERFLOW
# DB_POOL_TIMEOUT=10         # 等不到連線就放棄的秒數（池滿在單 worker 下已是異常）
# DB_POOL_RECYCLE=1800       # 連線最長壽命（秒）；比 pre_ping 更早汰換被中介砍掉的連線
#
# statement_timeout：沒有它，單一失控查詢可以無上限佔住一條連線——**這才是連線耗盡
# 的真正成因**，不是「併發使用者太多」（2026-07-29 AST 複驗：44 個 session 區塊沒有
# 任何一個跨 LLM 串流）。刻意不取更小的值：雷達目錄、overview 分面、閱讀頁 similar
# 都是天生偏慢的查詢，設太小會把正常功能打掛。
# DB_STATEMENT_TIMEOUT_MS=60000
#
# idle_in_transaction_session_timeout：**預設 0（關）是刻意的。**
# scripts/sync_new_reports.py 先 report_exists() 開了交易，接著才 spawn claude CLI
# 標註（硬逾時 150s）與跑 BGE-M3 嵌入（大檔數分鐘），中間沒有 commit ⇒ 設了它，
# 每 3 小時一次的生產同步會把報告靜默丟進 data/sync_failures.log。
# 要開就**只在 web 開**：批次腳本不讀 repo 根的 .env（sync unit 走
# /etc/default/report-mark-sync），所以在這裡設值天然只影響 web 行程。
# DB_IDLE_TX_TIMEOUT_MS=60000
#
# 維運長查詢的豁免值（0＝不限），給 db.relax_statement_timeout() 用的 SET LOCAL 值。
# 匯入最後那句 ANALYZE research.report_chunk 要在 70 萬列 × vector(1024) 上抽樣，
# 可能久於上面的 60s；它是最後一步，被砍掉只會靜默留下過期的 planner 統計。
# DB_MAINTENANCE_STATEMENT_TIMEOUT_MS=0

# ── M8 忠實度查核（全部選用；預設值即為程式內建值）────────────────────────
# 查核「回答/研報裡的主張有沒有語料支持」，結果寫進 qa_log.evaluation 與
# report_doc.evaluation（jsonb）。讀取路徑：監控頁「忠實度查核」卡片，
# 以及 `uv run python scripts/eval_faithfulness.py`（可 --claims <id> 逐條下鑽）。
#
# 全程 fail-open：judge 異常時該筆會寫 degraded=true、分數留 None，主流程不受影響。
# 這也代表**關掉或壞掉都不會有錯誤訊息**，只會讓 evaluation 停止累積——
# 監控卡片上的 fail-open 計數與「最後查核」日期就是為此存在。
# REPORT_FAITHFULNESS_ENABLED=1        # 研報端逐節 grounding + 修正一輪
# ASK_FAITHFULNESS_ENABLED=1           # 問答端抽查（done 之後才跑，不影響回應延遲）
# REPORT_FAITHFULNESS_MIN=0.9          # 低於此支持率的數值主張觸發修正；亦為監控頁「待複核」門檻
# ASK_FAITHFULNESS_SAMPLE_RATE=1.0     # 問答抽樣率 0..1（只查含金融數字的回答）
# FAITHFULNESS_MODEL=claude-haiku-4-5  # 未設時沿用 ASK_INTENT_MODEL
# FAITHFULNESS_TIMEOUT=60              # 單次 judge 逾時（秒）；逾時＝degraded，不是低分

# ── 併發與排隊（選用；預設值即為程式內建值）────────────────────────────
# /api/ask 併發上限 3、/api/report 預設序列化，兩者都是**行程內**狀態：加
# uvicorn --workers 會讓上限翻倍、BGE-M3 與 reranker 記憶體也翻倍，故啟動時會
# fail-closed 拒絕多 worker（web/concurrency.py）。要提高吞吐請先讀該檔。
# 滿載時 SSE 會先送一個 queued 事件（否則使用者只看到「連線建立但沒有任何回應」）；
# 排隊人數超過上限則在建立串流前回 429 + Retry-After（0 = 不限，退回舊行為）。
# ASK_MAX_QUEUE=20        # 問答排隊上限（上限 3、單題 60-90s）
# REPORT_MAX_QUEUE=5      # 研報排隊上限（序列化、單份 5-12 分鐘）；接回既有 run 豁免
