.venv/
__pycache__/
*.pyc
data/extracted/
# 抽取層 spike 的唯讀比對產物（scripts/profile_corpus.py／compare_extractors.py），
# 重跑就有；compare.html 一份就是數 MB。
data/extraction/
data/tags/
data/*.json
研報自動匯入/
.uv/
.playwright-mcp/
.playwright-cli/
*.png
# 說明頁截圖（UI 資產，被 SPA HelpPage 引用，需入版控；其餘 png 仍忽略）
!frontend/src/assets/help/*.png

# runtime logs / locks / tag backups（執行期產生，非原始碼）
data/*.log
data/*.lock
data/*.pid
data/.*.pid
data/.sync_last_hashes
# 匯入計數（PR #221）。與心跳同性質的純執行期狀態：每輪覆寫，遺失只會讓下一輪
# 的殼保守判成匯入異常，不會壞資料。**data/ 是逐項忽略，新增執行期檔案必須
# 同步加一行**，否則它會永遠掛在 git status 上，而這個 repo 明令禁止 git add -A
# 正是因為那種雜訊會讓人開始忽略 status。
data/.sync_last_stats
# 管線心跳（scripts/sync_new_reports.sh 寫、check_batch_freshness.py 讀）。
# 執行期狀態，不進版控。
data/.last_successful_sync
# 本輪狀態（sync 殼在進入點寫 running、EXIT/訊號 trap 寫終態，下一輪自己讀）。
# 同性質的純執行期狀態：遺失只會讓下一輪少補記一筆告警，不會壞資料。
data/sync_round_state
data/sync_delta_*.txt
# 硬體用量取樣（scripts/collect_resource_usage.py 每 20 秒一筆，約 10 MB／日，
# 自帶 --retention-days 修剪）。純執行期量測資料，不進版控——它描述的是
# 「這台機器這段時間」，換一台機器就完全沒有意義。
data/metrics/
data/tags.bak.*/

# 自動產生 / 一次性 artifact（舊的無障礙樹快照）
search-after.yml

# vite 的依賴預打包快取。frontend/.gitignore 已有一條 `.vite`，但那條只涵蓋
# frontend/ 底下；vite 的 cacheDir 是相對於**行程的 cwd** 解析的，所以從 repo 根
# 跑 `npx vite`（或任何在根目錄起 dev server 的腳本）會在這裡生出一份，
# 前者擋不到。內容是 node_modules 的衍生物，重跑就有。
/.vite/

# superpowers / SDD 本機 session 狀態（brainstorm/sdd，非原始碼）
.superpowers/
.worktrees/

# 對外存取邊緣的秘密（隧道 token / Basic Auth 帳密）
deploy/.env
deploy/secrets/

# App 登入帳密 / session 金鑰(本機環境設定)
/.env
# .env 的一切變體（備份／環境別）。根錨定的 /.env 涵蓋不到 .env.bak-<timestamp>
# 這類檔名，而它內含實際帳密與 session 金鑰——一次 `git add -A` 就會提交上去。
# 刻意擋一整類而非單一事件：.bak / .backup / .bk / .old / .save / .local 都算。
# 範本檔以 !.env.example 放行（無斜線，同時涵蓋 deploy/.env.example）。
.env.*
!.env.example

# Playwright 視覺稽核產物（2026-08 雷達工作台改版與版面稽核）。衍生物，重跑可得；
# 未被涵蓋時會有 31 個檔常駐 `git status` 的未追蹤清單，把真正需要注意的變更蓋掉。
/output/

# 2026-08-07 訊號回填期間的臨時觀測腳本。`data/` 是逐項忽略（不是整目錄），
# 這三個剛好不在任何既有規則內。刻意只忽略、不刪除——可能還有參考價值。
data/signal_chain.sh
data/signal_progress_sampler.sh
data/signal_progress.tsv

# P5 事件狀態（data/ 是逐項忽略，不是整目錄）。純執行期狀態：遺失只會讓下一次
# 失敗重新開一個事件，不影響正確性，因此刻意不進版控也不進備份。
data/.incidents/
data/.incidents-linebot/

# repo 根的 node_modules。frontend/.gitignore 只涵蓋 frontend/ 底下，而從根目錄跑
# npx／npm（例如 npx vite）會在這裡再生一份——與上面 /.vite/ 同一個成因。
# 內容是可重建的依賴衍生物，不進版控。
/node_modules/

# 2026-08-10 上雲與推論成本評估的簡報交付物與其檢視傾印（`*.inspect.ndjson`）。
# 一次性產出、非原始碼，且是二進位——一旦進了 git 歷史就只能靠改寫歷史才拿得掉，
# 而 `git add -A` 正是最可能把它們一起帶進去的方式。檔案本身已於 2026-09-01 的目錄
# 整理中刪除，規則保留是為了擋住下一批同類產物。
/*.pptx
/*.pptx.inspect.ndjson
