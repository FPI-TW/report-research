.venv/
__pycache__/
*.pyc
data/extracted/
data/tags/
data/reports/
data/*.json
研報自動匯入/
.uv/
.playwright-mcp/
.playwright-cli/
*.png
# 說明頁截圖（UI 資產，被 SPA HelpPage 引用，需入版控；其餘 png 仍忽略）
!frontend/src/assets/help/*.png
# 設計稿的圖片資產（docs/design/ 是設計交付存檔，非執行期產物）
!docs/design/**/*.png

# runtime logs / locks / tag backups（執行期產生，非原始碼）
data/*.log
data/*.lock
data/*.pid
data/.*.pid
data/.sync_last_hashes
data/sync_delta_*.txt
data/tags.bak.*/

# 自動產生 / 一次性 artifact（舊的無障礙樹快照）
search-after.yml

# superpowers / SDD 本機 session 狀態（brainstorm/sdd，非原始碼）
.superpowers/

# 對外存取邊緣的秘密（隧道 token / Basic Auth 帳密）
deploy/.env
deploy/secrets/

# App 登入帳密 / session 金鑰(本機環境設定)
/.env
# .env 的手動備份（曾出現 .env.bak-<timestamp>：未被 /.env 涵蓋，
# 一次 `git add -A` 就會把實際帳密與 session 金鑰提交上去）
.env.bak*
