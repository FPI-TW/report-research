      ],
      "Resource": "arn:aws:iam::607063196781:role/report-research-staging-Ec2Role-uhIYo8BjnDrT"
    },
    {
      "Sid": "ReadStagingInstanceProfileForCloudFormation",
      "Effect": "Allow",
      "Action": ["iam:GetInstanceProfile"],
      "Resource": "arn:aws:iam::607063196781:instance-profile/report-research-staging-Ec2InstanceProfile-3DGBXDbAQNmD"
    }
  ]
}
