# 容器部署（deploy/compose/docker-compose.yml）的設定。複製成同目錄的 .env 再填值：
#   cp .env.example .env && chmod 600 .env
# 這份檔同時給 compose 做變數代換、也以 env_file 交給每個應用容器——app 的所有旋鈕（見 repo 根
# .env.example 與 README「環境變數」）都可以加在這裡。值不做 shell 展開。
# 標【必填】的沒填，compose 或容器會拒絕啟動。說明見 docs/CONTAINER_DEPLOYMENT.md。

# ── 映像與 compose ───────────────────────────────────────────────
# 要部署的映像（docker build -f deploy/container/Dockerfile -t <名稱> . 或從內部 registry 拉）。
REPORT_MARK_IMAGE=report-mark:latest
# COMPOSE_PROJECT_NAME=report-mark
# 容器內的時區：排程工作（scheduler）依它解讀時間。
TZ=Asia/Taipei

# ── 資料庫 ───────────────────────────────────────────────────────
# 【必填】compose 內 postgres 的密碼（只在同一個 compose 網路內使用）。產生：openssl rand -hex 24
POSTGRES_PASSWORD=
# 用外部 DB 時改設這個（設了就不用上面那組）：postgresql+asyncpg://user:password@host:5432/dbname
# REPORT_MARK_DB_URL=

# ── 掛載 ─────────────────────────────────────────────────────────
# 【必填】備份落點（主機目錄，必須先建好且 UID 10001 可寫）：每日備份、migrate 前的全庫備份、稽核錨點、
# 刪帳 tombstone 都在這裡。放在與 Docker 資料（pgdata volume）不同的磁碟或網路儲存，否則磁碟壞掉時一起沒了。
#   sudo install -d -o 10001 -g 10001 -m 0750 /srv/report-mark-backups
BACKUP_HOST_DIR=/srv/report-mark-backups
# 【必填】profile 目錄（profile.toml、assets/、plugins/、eval/），唯讀掛載；相對路徑以本目錄為基準。
PROFILE_HOST_DIR=../../profiles/tingfong

# ── web ──────────────────────────────────────────────────────────
# 【必填】session 簽章金鑰，至少 32 字元；換掉＝全員登出。產生：openssl rand -hex 32
REPORT_MARK_SESSION_SECRET=
# web 對主機發佈的位址。預設只綁 loopback：對外一律經部署方的 TLS 反向代理。
WEB_PUBLISH=127.0.0.1:8097
# 反向代理在另一台主機或容器時：代理的來源位址（逗號分隔 CIDR）或共享祕密，二擇一即可（見 docs/EXTERNAL_ACCESS.md）。
# REPORT_MARK_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# REPORT_MARK_EDGE_SECRET=

# ── LLM（唯一預設會外連的整合）───────────────────────────────────
# 【必填】送達路徑與對應金鑰（LLM_PROVIDER=openai 用 OPENAI_API_KEY；端點可用 OPENAI_BASE_URL 改成內部閘道）。
# 其他送達路徑（azure_openai、anthropic、openai_compatible）的金鑰、端點與模型宣告旋鈕見 repo 根 .env.example。
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── 預設關閉的外連整合（開之前讀文件「零外連清單」）────────────────
# 網搜（沒有後端，保持 0）
ASK_ENABLE_WEB=0
# 物件儲存：local＝原檔放 data volume；hybrid／r2 會連物件儲存。
OBJECT_STORAGE_MODE=local
# 告警 webhook（上傳 worker 的失敗通知）：留空＝不送。
# REPORT_MARK_ALERT_WEBHOOK=

# ── 上傳（預設關）────────────────────────────────────────────────
# 開了要一併起 clamd：docker compose --profile clamav up -d（clamd 的病毒碼更新是外連，見文件）。
UPLOAD_ENABLED=0
# UPLOAD_WORKER_INTERVAL_SECONDS=300

# ── 排程（scheduler）────────────────────────────────────────────
# 逗號分隔的工作名（清單見 deploy/container/scheduler.py）；打錯名字 scheduler 會拒絕啟動。
# SCHEDULER_DISABLE=
# SCHEDULER_ENABLE=retrieval-regression

# ── migrate ─────────────────────────────────────────────────────
# 對已有資料的庫升級時才設（逐字等於 migrate 印出的 host:port/db）；升級完就刪掉這行。
# REPORT_MARK_MIGRATE_CONFIRM=
# MIGRATE_DUMP_TIMEOUT_MIN=90
