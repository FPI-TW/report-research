[Unit]
Description=研報平台 維運代理（服務狀態與日誌；Web 經 Unix socket 呼叫）
# 安裝與驗收見 docs/CONTAINER_DEPLOYMENT.md「維運代理（選配）」。
#
# 為什麼不讓 web 自己跑 docker／systemctl／journalctl：web 對外服務，被攻破時能做的事要越少越好。web 只能經
# /run/report-mark-ops/agent.sock 送 catalog 允許的請求（ops_agent/protocol.py），沒有任意 shell、任意容器或 unit。
# 寫入類（restart、run）只給 systemd unit，而且 systemd 那端由 polkit 再限定一次
# （deploy/ops-agent/10-report-mark-ops.rules）；範本 catalog 只列容器、全部唯讀。
#
# 刻意不宣告 OnFailure：代理停掉不是生產事故（服務照跑，只是管理後台的維運頁回 503 ops_agent_unavailable）。
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# 專用的系統使用者（不是任何服務的執行身分）。建立方式見安裝說明。
User=report-mark-ops
Group=report-mark-ops
# docker inspect／logs 要 docker 群組；列 systemd unit 的日誌才需要 systemd-journal。
#
# 威脅模型：docker 群組等同 root（能連 /var/run/docker.sock 就能 `docker run -v /:/host`）。安全性建立在三件事上：
#   1. 程式碼與 catalog 在 root 擁有、其他人不可寫的 /opt/report-mark-ops/（不是從原始碼目錄執行）。
#   2. 代理只組固定的 argv（docker inspect／docker logs，參數嚴格驗證），不經 shell。
#   3. socket 只給 catalog 點名的 uid（SO_PEERCRED）＋socket 群組。
SupplementaryGroups=systemd-journal docker
WorkingDirectory=/opt/report-mark-ops
# -B：不寫 __pycache__（/opt 唯讀）；-E：不讀 PYTHON* 環境變數；-s：不加使用者 site-packages。代理只用標準庫，
# 刻意用系統的 python3、不用應用程式的虛擬環境。
ExecStartPre=/usr/bin/python3 -B -E -s -m ops_agent --catalog /opt/report-mark-ops/services.toml --check
ExecStart=/usr/bin/python3 -B -E -s -m ops_agent --catalog /opt/report-mark-ops/services.toml
# socket 目錄 /run/report-mark-ops：owner report-mark-ops、群組 report-mark-ops、0750；socket 本身 0660。
# web 容器以 deploy/ops-agent/docker-compose.ops-agent.yml 掛進這個目錄，並加入這個群組的 gid。
RuntimeDirectory=report-mark-ops
RuntimeDirectoryMode=0750
# 重啟代理時保留目錄本身（socket 檔照常重建）：web 容器 bind mount 的是這個目錄，目錄被刪掉重建時容器裡會留著
# 舊的那一個、再也連不到新 socket。
RuntimeDirectoryPreserve=yes
UMask=0007
Restart=always
RestartSec=5
TimeoutStopSec=15
# 最小權限：不需要任何 capability、不寫任何檔案（RuntimeDirectory 例外）、只用 AF_UNIX。
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# catalog 的寫入類服務帶 flock_files／pid_files（主機上的批次鎖）時，以 BindReadOnlyPaths= 唯讀綁進那個目錄。
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
