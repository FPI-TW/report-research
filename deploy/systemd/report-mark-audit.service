[Unit]
Description=廷豐智能研報 資料完整性稽核（唯讀，純 SQL，零 LLM）
# DB 是 Docker 容器 report-mark-postgres，非本 distro systemd 管理，故不宣告 After=；
# 連不上時腳本以 rc=2 結束（刻意與「有發現」的 rc=1 分開，處置不同：前者去看
# /healthz，後者去看發現本身）。
After=network-online.target
Wants=network-online.target
# 這支存在的最強理由是**耐久性可能被永久關掉而完全看不出來**：
# scripts/ingest_lowio.sh 會 ALTER SYSTEM SET fsync=off 並以 trap ... EXIT 還原，
# 但 trap 擋不住 SIGKILL（OOM killer、kill -9、WSL 整個被收掉），而 ALTER SYSTEM
# 是寫進 postgresql.auto.conf 的 —— **重啟也不會恢復**。DB 於是無限期跑在
# fsync=off：查詢完全正常、沒有任何症狀，但一次斷電就可能讓整個 pgdata 報廢。
# 其餘檢查（孤兒列、NULL embedding、重複 chunk_index、market 不一致、content_norm
# 漂移）的共同點也是「壞掉的方式全部靜默」。
# 復用既有告警鏈（journal ERROR ＋ data/unit_failures.log ＋ opt-in webhook），
# 不開新管道 —— report-mark-alert.sh 恆容錯、恆 exit 0，被多一個 unit 呼叫是安全的。
OnFailure=report-mark-alert@%n.service

[Service]
Type=oneshot
User=kashionz
Group=kashionz
# HOME 必須硬編碼，不可用 %h：系統層 unit 的 %h 一律解析為 service manager 的家目錄
# （/root），**不受 User= 影響**。2026-07-28 的 sync unit 就是這樣連續 10 輪 exit 2、
# 整條入庫管線停擺 24 小時。與同目錄其他 unit 對齊（tests/test_deploy_units.py 守門）。
Environment=HOME=/home/kashionz
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 沿用 sync 的環境檔（REPORT_MARK_ROOT / SYNC_PATH_EXTRA 都在裡面）。
EnvironmentFile=-/etc/default/report-mark-sync
# SYNC_PATH_EXTRA 是為了找到 **uv**（在 ~/.local/bin，不在 systemd 預設 PATH）。
# 這支零 LLM。
# 用 bash -c 而非 -lc：-l 會去讀登入 shell 的 profile，讓 PATH 來源變得不可預期。
ExecStart=/usr/bin/bash -c 'export PATH="${SYNC_PATH_EXTRA:+$SYNC_PATH_EXTRA:}$PATH"; cd "${REPORT_MARK_ROOT:?set REPORT_MARK_ROOT in /etc/default/report-mark-sync}" && exec "${UV:-uv}" run python scripts/db_audit.py'
# 幾條是 57 萬列的全表掃描，腳本內走 relax_statement_timeout（引擎層 60s 會砍掉它們，
# 而被砍掉的稽核等於沒有稽核）。600s 是那些掃描 + content_norm 取樣的寬鬆上界。
TimeoutStartSec=600
