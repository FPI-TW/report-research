[Unit]
Description=廷豐智能研報 既有語料抽取回填（E1d：pdfplumber 版面層，深夜分批、零 LLM）
# DB 是 Docker 容器 report-mark-postgres，非本 distro systemd 管理，故不宣告 After=；
# 連不上時腳本以 rc=2 結束（→ OnFailure）。
After=network-online.target
Wants=network-online.target
# 回填失敗要有人知道：單篇失敗 rc=1（已記 data/backfill_failures.log）、DB 不可用 rc=2，
# 兩者都走既有告警鏈。全部跑完是 rc=0 的 no-op，不會叫。
OnFailure=report-mark-alert@%n.service

[Service]
Type=oneshot
User=kashionz
Group=kashionz
# HOME 硬編碼，不可用 %h（系統層 unit 的 %h 一律是 /root，不受 User= 影響）。
Environment=HOME=/home/kashionz
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 沿用 sync 的環境檔：REPORT_MARK_ROOT／SYNC_PATH_EXTRA（找 uv 用）／EXTRACTOR 都在裡面。
EnvironmentFile=-/etc/default/report-mark-sync
# 零 LLM，不需要 claude；吃的是 BGE-M3 的 CPU。Nice 讓白天萬一撞上問答時讓路。
Nice=10
# --extractor 顯式給 pdfplumber：回填目標不該跟著環境檔的 EXTRACTOR 漂（E1d 切換前
# 環境檔仍是 pypdf，回填照樣要往版面層走）。--max-minutes 240 是 E1 共識第 2 條。
ExecStart=/usr/bin/bash -c 'export PATH="${SYNC_PATH_EXTRA:+$SYNC_PATH_EXTRA:}$PATH"; cd "${REPORT_MARK_ROOT:?set REPORT_MARK_ROOT in /etc/default/report-mark-sync}" && exec "${UV:-uv}" run python scripts/backfill_extraction.py --extractor pdfplumber --max-minutes 240'
# 240 分鐘的預算 ＋ 最後一篇的收尾（長報告嵌入可到十幾分鐘）＋ 冷載入 BGE-M3 約 90 秒。
TimeoutStartSec=16200

[Install]
WantedBy=multi-user.target
