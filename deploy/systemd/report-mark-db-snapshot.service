[Unit]
Description=廷豐智能研報 DB 統計快照（系統目錄→db_stat_snapshot；逐時 30 天、每日 400 天；純 SQL，零 LLM）
# 每小時寫一列逐時快照（庫大小、連線數、dead tuple、未使用索引、快取命中率的累計值、前 20 大表），每天第一次執行時把
# 前一天彙總成一列每日，並刪除逐時超過 30 天、每日超過 400 天的列。這只是監控統計，不是 DB dump，不備份。
# 細節見 scripts/db_snapshot.py 檔頭與 app/services/db_insights.py。
After=network-online.target
Wants=network-online.target
# 掛 OnFailure，但 DB 不可用（rc=2）列為成功（見 SuccessExitStatus），理由同 report-mark-rollup-observations：
# DB 掛掉本身已由 web 探針經 P5 帶去重地告警，report-mark-alert@ 沒有去重，rc=2 若算失敗就是每小時一則重複通知。
# rc=1（SQL 錯誤、bug）沒有其他東西會發現（趨勢圖只是默默缺一段），只讓它走告警。
OnFailure=report-mark-alert@%n.service

[Service]
Type=oneshot
User=kashionz
Group=kashionz
# HOME 硬編碼，不可用 %h（系統層 unit 的 %h 一律解析為 /root，不受 User= 影響）。
Environment=HOME=/home/kashionz
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/default/report-mark-sync
ExecStart=/usr/bin/bash -c 'export PATH="${SYNC_PATH_EXTRA:+$SYNC_PATH_EXTRA:}$PATH"; cd "${REPORT_MARK_ROOT:?set REPORT_MARK_ROOT in /etc/default/report-mark-sync}" && exec "${UV:-uv}" run python scripts/db_snapshot.py'
# 2＝DB 不可用（由 P5 告警），不是這支批次的故障。
SuccessExitStatus=2
# 正常一輪是幾句系統目錄查詢（各段 statement_timeout 5 秒）加上一兩句寫入，數秒內結束。
TimeoutStartSec=300
Nice=10
# 只是短命的 Python＋asyncpg：不載檢索／嵌入模組（tests/test_db_snapshot.py 守門），給一個保守上限防意外。
MemoryMax=512M
