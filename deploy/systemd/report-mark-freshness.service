[Unit]
Description=廷豐智能研報 批次停更偵測（純 SQL，零 LLM）
# DB 是 Docker 容器 report-mark-postgres，非本 distro systemd 管理，故不宣告 After=；
# 連不上時腳本以 rc=2 結束（刻意與「停更」的 rc=1 分開，處置不同）。
After=network-online.target
Wants=network-online.target
# 這支的**全部價值**就在這一行：派生資產停更本來沒有任何訊號會亮。
# `sync_new_reports.sh` 把摘要／標題／摘錄設成 best-effort（失敗只 log、不 exit），
# 那個設計是對的，但代價是連續失敗永遠不會讓 sync unit 變紅 ⇒ OnFailure 一次都不觸發。
# 2026-07 實測 takeaway 停更 8 天、signal 停更 12 天，都是事後才發現。
# 直接復用既有告警鏈（journal ERROR ＋ data/unit_failures.log ＋ opt-in webhook），
# 不開新管道——report-mark-alert.sh 恆容錯、恆 exit 0，被多一個 unit 呼叫是安全的。
OnFailure=report-mark-alert@%n.service

[Service]
Type=oneshot
User=kashionz
Group=kashionz
# HOME 必須硬編碼，不可用 %h：系統層 unit 的 %h 一律解析為 service manager 的家目錄
# （/root），**不受 User= 影響**。2026-07-28 的 sync unit 就是這樣連續 10 輪 exit 2、
# 整條入庫管線停擺 24 小時。與同目錄其他 unit 對齊（tests/test_deploy_units.py 守門）。
Environment=HOME=/home/kashionz
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 沿用 sync 的環境檔（REPORT_MARK_ROOT / SYNC_PATH_EXTRA 都在裡面）。
EnvironmentFile=-/etc/default/report-mark-sync
# SYNC_PATH_EXTRA 是為了找到 **uv**（在 ~/.local/bin，不在 systemd 預設 PATH）。
# 這支零 LLM。
# 用 bash -c 而非 -lc：-l 會去讀登入 shell 的 profile，讓 PATH 來源變得不可預期。
ExecStart=/usr/bin/bash -c 'export PATH="${SYNC_PATH_EXTRA:+$SYNC_PATH_EXTRA:}$PATH"; cd "${REPORT_MARK_ROOT:?set REPORT_MARK_ROOT in /etc/default/report-mark-sync}" && exec "${UV:-uv}" run python scripts/check_batch_freshness.py'
TimeoutStartSec=300
