# LLM 專用環境檔：DeepSeek 金鑰與批次的模型旋鈕。安裝到 /etc/default/report-mark-llm。
#
# 安裝（權限 0640 root:kashionz：sync unit 以 kashionz 執行，手動批次也以 kashionz 讀）：
#   sudo install -m 0640 -o root -g kashionz deploy/systemd/report-mark-llm.env.example /etc/default/report-mark-llm
#   sudoedit /etc/default/report-mark-llm
# 填金鑰只用 sudoedit。不要 echo 或 tee（金鑰會進 shell history 與行程列表），
# 也不要在 shell 裡 source 這個檔（值會外溢到整個 shell 與它的子行程）。
#
# 誰讀這個檔：
#   - report-mark-sync.service 以 EnvironmentFile= 載入（其他 unit 都不載入）。
#   - 手動跑的 LLM 批次與評測由 scripts/_llm_env.py 自己讀，只補環境裡還不存在的鍵。
#   - web 不讀這個檔，讀 repo 根的 .env：兩份的 DEEPSEEK_API_KEY 必須逐字相同。
# 改完不需要 daemon-reload（EnvironmentFile 每次啟動重讀）；改了 .env 那份要重啟 web。
#
# 格式規則（systemd 與 scripts/_llm_env.py 都要讀得懂）：
#   - 一行一個 KEY=value，值不加引號，不寫行尾註解（systemd 會把 # 之後當成值的一部分）。
#   - 同一個鍵只能出現一次：systemd 取最後一行、手動批次取第一行，重複時批次以 rc=2 拒跑。
#     輪替金鑰時直接改那一行，不要新增一行。

# DeepSeek 金鑰；範例檔永遠留空。輪替步驟見 docs/production_resilience.md。
DEEPSEEK_API_KEY=

# 供應商：claude_cli（預設）／deepseek／claude_only（緊急回退：旋鈕裡的 DeepSeek 名稱一律忽略）。
# 批次（run_claude、generate_brief）依白名單分派：DeepSeek 名稱走 HTTP、claude-* 走 CLI。
# web 讀的是 repo 根 .env 的同名鍵，兩份可以不同（線上與批次可以分開切換）。
LLM_PROVIDER=claude_cli

# 批次的模型旋鈕；留空＝依 LLM_PROVIDER 查預設表（app/services/llm_models.py）。
# 只接受 DeepSeek 白名單（deepseek-flash、deepseek-v4-pro、deepseek-v4-flash）或 claude-*。
# 填 DeepSeek 名稱時這份檔的 DEEPSEEK_API_KEY 必須有值，否則該批次預檢 rc=2 拒跑並印出是哪個旋鈕。
TAG_MODEL=
SUMMARY_MODEL=
TITLE_MODEL=
TAKEAWAY_MODEL=
SIGNAL_MODEL=
BRIEF_MODEL=

# 預算（佔位）：目前沒有程式讀取，DeepSeek 餘額與月預算的每日檢查上線後才生效。
LLM_BUDGET_CURRENCY=USD
LLM_MONTHLY_BUDGET_USD=50
LLM_BALANCE_FLOOR_USD=10
