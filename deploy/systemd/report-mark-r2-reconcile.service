[Unit]
Description=廷豐智能研報 R2 物件儲存對帳（唯讀，零 LLM）
# DB 是 Docker 容器 report-mark-postgres，非本 distro systemd 管理，故不宣告 After=。
After=network-online.target
Wants=network-online.target
# 這支存在的理由：切到 OBJECT_STORAGE_MODE=r2 之後，R2 不通或某篇缺 key 的症狀是
# 閱讀頁與下載回 503、sync 該輪入庫失敗——而 /healthz 只探 DB、P4 探針刻意不 import
# app.*，兩者全程綠。reconcile_object_storage.py --dry-run 對 DB 每一筆產物做 HEAD，
# 有 missing／SHA 不符／orphan／連不上就非零退出，這裡把它接上既有告警鏈。
# OBJECT_STORAGE_MODE=local 時腳本印一行並 rc=0（尚未切換的期間不會誤報）。
# 復用既有告警鏈（journal ERROR ＋ data/unit_failures.log ＋ opt-in webhook）。
OnFailure=report-mark-alert@%n.service

[Service]
Type=oneshot
User=kashionz
Group=kashionz
# HOME 必須硬編碼，不可用 %h：系統層 unit 的 %h 一律解析為 /root，不受 User= 影響
# （tests/test_deploy_units.py 守門）。
Environment=HOME=/home/kashionz
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 沿用 sync 的環境檔：REPORT_MARK_ROOT / SYNC_PATH_EXTRA 與 R2_* 憑證都在裡面。
EnvironmentFile=-/etc/default/report-mark-sync
# SYNC_PATH_EXTRA 是為了找到 uv（這支零 LLM）。
ExecStart=/usr/bin/bash -c 'export PATH="${SYNC_PATH_EXTRA:+$SYNC_PATH_EXTRA:}$PATH"; cd "${REPORT_MARK_ROOT:?set REPORT_MARK_ROOT in /etc/default/report-mark-sync}" && exec "${UV:-uv}" run python scripts/reconcile_object_storage.py --dry-run --kind all'
# 一萬五千多筆 HEAD、併發 4：正常十幾分鐘內；取 1 小時當上界，超過就是 R2 不對勁。
TimeoutStartSec=3600
