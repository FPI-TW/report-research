# 安裝到 /etc/default/report-mark-sync；把主機專屬值留在部署環境，不寫死在 unit。
REPORT_MARK_ROOT=/mnt/c/Users/User/Desktop/Project/report-mark

# 讓 service 能找到 claude / uv 等額外執行檔；依實機調整。
SYNC_PATH_EXTRA=/home/kashionz/.nvm/versions/node/current/bin:/home/kashionz/.local/bin

# 若 uv 不在 PATH，可顯式指定：
# UV=/home/kashionz/.local/bin/uv
