{
  "version": 1,
  "as_of": "2026-06-24",
  "_note": "離線檢索評估標註集。expect 以關鍵字+日期條件描述（非寫死 report_id，對語料重 ingest 穩健）。any_keywords 比對來源報告的『檔名+片段內容』正規化後 substring；recency.max_age_days 用於判定是否至少引用到一篇夠新的報告。修改後用 scripts/eval_retrieval.py 重跑。",
  "cases": [
    {
      "id": "tsmc-outlook",
      "query": "台積電最新的營運展望如何",
      "filters": { "market": "TW" },
      "expect": { "any_keywords": ["台積電"], "min_hits": 1, "recency": { "max_age_days": 60 } }
    },
    {
      "id": "taiex-trend",
      "query": "台股大盤近期走勢與展望",
      "filters": { "market": "TW" },
      "expect": { "any_keywords": ["台股", "大盤", "加權指數"], "min_hits": 1, "recency": { "max_age_days": 45 } }
    },
    {
      "id": "ai-server-supply",
      "query": "AI 伺服器供應鏈近期表現怎麼樣",
